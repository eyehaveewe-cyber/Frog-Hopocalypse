extends SceneTree
const Data = preload("res://scripts/level_data.gd")
const Suite = preload("res://tests/integration.gd")
var suite = Suite.new()
var app: Control
func _initialize() -> void:
 app = preload("res://main.tscn").instantiate()
 root.add_child(app)
 call_deferred("run")
func run() -> void:
 await process_frame
 app.set_process(false)
 app.world.set_physics_process(false)
 app.voice.unlock()
 app.voice.say("begin")
 app.set_sound_enabled(false)
 suite.check(not app.voice.busy() and not app.voice.enabled and app.sound_button.text == "Sound: Off" and not app.menu_sound_toggle.button_pressed, "Sound off immediately stops playback and synchronizes both toggles")
 app.load_profile()
 suite.check(not app.sound_enabled, "Sound preference survives profile reload")
 app.set_sound_enabled(true)
 suite.check(app.voice.enabled and app.sound_button.text == "Sound: On" and app.menu_sound_toggle.button_pressed, "Sound on restores playback and both toggles")
 app.level = Data.blank("Checkpoint test", "egypt", 9,9)
 app.enter_editor()
 suite.check(app.edit_button.visible and app.edit_button.text.begins_with("Playtest"), "Editor keeps its playtest button")
 app.set_tool("checkpoint")
 app.edit_cell(Vector2i(2,6))
 app.edit_cell(Vector2i(5,3))
 suite.check(app.level.checkpoints == [[2,6],[5,3]] and app.world.checkpoint_flags.size() == 2, "Editor places multiple visible checkpoint flags")
 app.undo()
 suite.check(app.level.checkpoints == [[2,6]], "Undo removes the last checkpoint")
 app.redo()
 suite.check(app.level.checkpoints.size() == 2, "Redo restores checkpoint")
 var saved: Dictionary = Data.normalize(JSON.parse_string(JSON.stringify(app.level)))
 suite.check(saved == app.level and Data.validate(saved).is_empty(), "Multiple checkpoints round-trip through portable JSON")
 app.set_tool("wall")
 app.edit_cell(Vector2i(2,6))
 suite.check(app.level.tiles[6][2] == "floor", "Painting hazards cannot invalidate a checkpoint tile")
 app.set_tool("checkpoint")
 app.edit_cell(Vector2i(0,4))
 suite.check(app.level.checkpoints.size() == 2, "Checkpoint tool rejects walls")
 app.edit_cell(Vector2i(1,7))
 suite.check(app.level.checkpoints.size() == 2, "Checkpoint tool rejects the frog start")
 app.exit_preview = false
 app.playtest()
 await process_frame
 await process_frame
 suite.check(app.world.checkpoint_flags.all(func(marker): return is_instance_valid(marker.flag)), "Checkpoint flag meshes remain live after static batching and frame cleanup")
 suite.check(app.mode == "test" and not app.edit_button.visible, "Editor entry is hidden during playtest")
 app.world.player.position = app.world.cell_position([6,2])
 app.world._physics_process(0.01)
 suite.check(app.checkpoint_spawn.is_empty(), "Passing a checkpoint row elsewhere does not claim an editor checkpoint")
 app.world.player.position = app.world.cell_position([2,6])
 app.world._physics_process(0.01)
 suite.check(app.checkpoint_spawn == [2,6] and app.checkpoint_history == [[2,6]], "Entering a flag tile claims its checkpoint")
 app.world.finish("CROAKED!")
 app.retry()
 suite.check(app.world.position_cell(app.world.player.position) == Vector2i(2,6) and app.world.claimed_checkpoints == [[2,6]], "Death retry restores checkpoint spawn and claimed flags")
 app.world.player.position = app.world.cell_position([5,3])
 app.world._physics_process(0.01)
 app.world.player.position = app.world.cell_position([2,6])
 app.world._physics_process(0.01)
 suite.check(app.checkpoint_spawn == [5,3] and app.checkpoint_history.size() == 2, "A later checkpoint advances retry spawn; old claimed flags do not overwrite it")
 app.world.finish("HIT!")
 app.retry()
 suite.check(app.world.position_cell(app.world.player.position) == Vector2i(5,3), "Subsequent retry uses latest checkpoint")
 app.show_menu()
 var buttons: Array = app.overlay_box.find_children("*", "Button", true, false).map(func(b):return b.text)
 suite.check("Level editor · Create a maze" in buttons and not app.edit_button.visible, "Main screen retains the editor entry")
 app.enter_editor()
 app.set_tool("erase")
 app.stroke_changed = false
 app.edit_cell(Vector2i(2,6))
 suite.check(app.level.checkpoints == [[5,3]], "Erase removes a checkpoint without changing the underlying floor")
 app.playtest()
 suite.check(app.checkpoint_spawn.is_empty() and app.checkpoint_history.is_empty(), "Starting a fresh playtest clears old checkpoint progress")
 app.enter_editor()
 app.level = Data.load_json(app.BUILTINS[3])
 app.start_play(false)
 app.world.player.position = app.world.cell_position(app.level.checkpoint)
 app.world._physics_process(0.01)
 suite.check(app.checkpoint_spawn == app.level.checkpoint and not app.edit_button.visible, "Existing Baby crossing bank checkpoint remains compatible and gameplay hides editor")
 var bad := saved.duplicate(true)
 bad.checkpoints = [[2,6],[2,6]]
 suite.check(not Data.validate(bad).is_empty(), "Duplicate checkpoints are rejected on import")
 bad.checkpoints = [[2.5,6]]
 suite.check(not Data.validate(bad).is_empty(), "Fractional checkpoint cells are rejected on import")
 print("SOUND/CHECKPOINTS: %d checks, %d failures" % [suite.checks,suite.failures.size()])
 quit(0 if suite.failures.is_empty() else 1)
